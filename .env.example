# 服务端口
PORT=3000

# 本地 PostgreSQL 数据库（用 docker compose up -d 启动）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotspot_monitor?schema=public"

# 第三方热搜接口 twitterapi.io 的 API Key（单 key）
# 接口：GET https://api.twitterapi.io/twitter/trends?woeid={woeid}&count={count}
# 鉴权：请求头 X-API-Key
# 文档：https://docs.twitterapi.io/introduction
TWITTERAPI_IO_KEY=

# 大模型（OpenAI），用于热点内容分类等能力
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding（向量检索，用于 Event 归并去重）
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
