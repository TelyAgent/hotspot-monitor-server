generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrendingRecord {
  id          String   @id @default(cuid())
  region      String
  rank        Int
  name        String
  query       String
  url         String
  collectedAt DateTime @default(now())

  @@index([region, collectedAt])
}

// 采集行为记录：每个地区每次采集只记一行（真实调用 / 回退 mock），用于 2 小时节流与费用基线
model TrendFetchLog {
  id        String   @id @default(cuid())
  region    String
  source    String
  count     Int      @default(0)
  fetchedAt DateTime @default(now())

  @@index([region, fetchedAt])
}

model TopicCirclePost {
  id           String   @id @default(cuid())
  postId       String   @unique
  circle       String
  handle       String
  text         String
  url          String?
  viewCount    Int?
  retweetCount Int?
  replyCount   Int?
  likeCount    Int?
  postedAt     DateTime
  collectedAt  DateTime @default(now())

  @@index([circle, postedAt])
  @@index([handle, postedAt])
}

model TopicCircleSyncState {
  handle          String   @id
  lastCollectedAt DateTime
  updatedAt       DateTime @updatedAt
}

model TopicCircleTopic {
  id                String    @id @default(cuid())
  circle            String
  title             String
  summary           String
  coreFact          String
  coreFactEmbedding Unsupported("vector(1536)")?
  postIds           Json
  b3h               Int       @default(0)
  b24h              Int       @default(0)
  tmax              Float?
  tmaxTop5          Boolean   @default(false)
  eventId           String?
  triggeredAt       DateTime?
  triggerType       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([circle, createdAt])
}

model Signal {
  id           String   @id @default(cuid())
  source       String
  sourceItemId String
  region       String?
  title        String
  summaryText  String?
  url          String?
  rank         Int?
  previousRank Int?
  snapshotId   String?
  trigger      String?
  extra        Json?
  collectedAt  DateTime
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id])

  @@unique([source, sourceItemId, snapshotId])
  @@index([collectedAt])
}

model Event {
  id                String   @id @default(cuid())
  title             String
  summary           String
  coreFact          String
  coreFactEmbedding Unsupported("vector(1536)")?
  verify            String
  status            String
  regions           Json
  trigger           String
  rank              Int?
  rankChange        Int?
  firstDiscoveredAt DateTime
  updatedAt         DateTime @updatedAt

  signals            Signal[]
  evidence           Evidence[]
  outgoingRelations  EventRelation[] @relation("outgoing")
  incomingRelations  EventRelation[] @relation("incoming")
  tasks              Task[]

  @@index([coreFact])
  @@index([firstDiscoveredAt])
}

model Evidence {
  id      String  @id @default(cuid())
  eventId String
  region  String?
  url     String
  snippet String?
  order   Int
  event   Event   @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

model EventRelation {
  id           String @id @default(cuid())
  fromEventId  String
  toEventId    String
  relationType String

  from Event @relation("outgoing", fields: [fromEventId], references: [id])
  to   Event @relation("incoming", fields: [toEventId], references: [id])

  @@unique([fromEventId, toEventId, relationType])
  @@index([fromEventId])
  @@index([toEventId])
}

model Account {
  id             String   @id @default(cuid())
  name           String   @unique
  type           String
  layer          String
  skill          String
  persona        String?
  xHandle        String?
  takesAllEvents Boolean  @default(false)
  status         String   @default("正常")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tasks          Task[]

  @@index([type])
  @@index([layer])
}

model Task {
  id         String   @id @default(cuid())
  code       String
  eventId    String
  accountId  String
  status     String   @default("生成中")
  risk       String   @default("普通")
  candidates Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event   Event         @relation(fields: [eventId], references: [id])
  account Account       @relation(fields: [accountId], references: [id])
  post    PublishedPost?

  @@unique([eventId, accountId])
  @@index([status])
}

model PublishedPost {
  id                String   @id @default(cuid())
  taskId            String   @unique
  url               String   @unique
  publishedAt       DateTime
  selectedCandidate Int?
  trackingStatus    String   @default("追踪中")
  trackingEndsAt    DateTime
  wellPerforming    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  task    Task         @relation(fields: [taskId], references: [id])
  metrics PostMetric[]

  @@index([publishedAt])
  @@index([trackingStatus])
}

model PostMetric {
  id         String        @id @default(cuid())
  postId     String
  views      Int?
  likes      Int?
  replies    Int?
  reposts    Int?
  quotes     Int?
  capturedAt DateTime
  post       PublishedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, capturedAt])
}

model Connector {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  baseUrl       String?
  authMethod    String?
  syncFrequency String?
  timeoutRetry  String?
  fallback      String?
  enabled       Boolean  @default(true)
  fields        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MonitoringRule {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  regions       String?
  threshold     String?
  compareWindow String?
  action        String?
  enabled       Boolean  @default(true)
  fields        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Topic {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  keywords         String?
  positiveExamples String?
  negativeExamples String?
  action           String?
  accounts         String?
  enabled          Boolean  @default(true)
  fields           Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AccountConfig {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  xAccountId  String?
  type        String?
  skill       String?
  frequency   String?
  onFailure   String?
  enabled     Boolean  @default(true)
  fields      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductConfig {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  url         String?
  targetUsers String?
  capability  String?
  forbidden   String?
  lastSync    String?
  enabled     Boolean  @default(true)
  fields      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskRule {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  rule         String?
  lowAction    String?
  midAction    String?
  highAction   String?
  afterRelease String?
  enabled      Boolean  @default(true)
  fields       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TrackingRule {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  timeRange   String?
  value       String?
  metrics     String?
  onFailure   String?
  goodExtend  String?
  enabled     Boolean  @default(true)
  fields      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FutureSource {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  url           String?
  method        String?
  evidenceLevel String?
  syncFrequency String?
  maxStale      String?
  enabled       Boolean  @default(true)
  fields        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Permission {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  scope            String?
  overridable      String?
  effectiveOn      String?
  auditRequirement String?
  enabled          Boolean  @default(true)
  fields           Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SettingAudit {
  id        String   @id @default(cuid())
  object    String
  action    String
  operator  String
  version   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FutureEvent {
  id                 String    @id @default(cuid())
  title              String
  subject            String
  eventType          String
  factTime           DateTime?
  timezone           String    @default("UTC")
  schedulePrecision  String
  confirmationLevel  String
  expressionBoundary String
  actionScore        Json
  evidence           Json
  windows            Json
  heat               Json
  relatedEventId     String?
  entryMode          String?
  ruleVersion        String    @default("v1")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([factTime])
}

model FutureSourceStatus {
  id         String    @id @default(cuid())
  source     String    @unique
  enabled    Boolean   @default(true)
  lastSyncAt DateTime?
  status     String
  nextSyncAt DateTime?
  message    String?
}
