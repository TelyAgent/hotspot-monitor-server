generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrendingRecord {
  id          String   @id @default(cuid())
  region      String
  rank        Int
  name        String
  query       String
  url         String
  collectedAt DateTime @default(now())

  @@index([region, collectedAt])
}
