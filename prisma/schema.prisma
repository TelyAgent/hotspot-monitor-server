generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrendingRecord {
  id          String   @id @default(cuid())
  region      String
  rank        Int
  name        String
  query       String
  url         String
  collectedAt DateTime @default(now())

  @@index([region, collectedAt])
}

model Signal {
  id           String   @id @default(cuid())
  source       String
  sourceItemId String
  region       String?
  title        String
  summaryText  String?
  url          String?
  rank         Int?
  previousRank Int?
  snapshotId   String?
  trigger      String?
  extra        Json?
  collectedAt  DateTime
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id])

  @@unique([source, sourceItemId, snapshotId])
  @@index([collectedAt])
}

model Event {
  id                String   @id @default(cuid())
  title             String
  summary           String
  coreFact          String
  coreFactEmbedding Unsupported("vector(1536)")?
  verify            String
  status            String
  regions           Json
  trigger           String
  rank              Int?
  rankChange        Int?
  firstDiscoveredAt DateTime
  updatedAt         DateTime @updatedAt

  signals            Signal[]
  evidence           Evidence[]
  outgoingRelations  EventRelation[] @relation("outgoing")
  incomingRelations  EventRelation[] @relation("incoming")
  tasks              Task[]

  @@index([coreFact])
  @@index([firstDiscoveredAt])
}

model Evidence {
  id      String  @id @default(cuid())
  eventId String
  region  String?
  url     String
  snippet String?
  order   Int
  event   Event   @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

model EventRelation {
  id           String @id @default(cuid())
  fromEventId  String
  toEventId    String
  relationType String

  from Event @relation("outgoing", fields: [fromEventId], references: [id])
  to   Event @relation("incoming", fields: [toEventId], references: [id])

  @@unique([fromEventId, toEventId, relationType])
  @@index([fromEventId])
  @@index([toEventId])
}

model Account {
  id             String   @id @default(cuid())
  name           String   @unique
  type           String
  layer          String
  skill          String
  persona        String?
  xHandle        String?
  takesAllEvents Boolean  @default(false)
  status         String   @default("正常")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tasks          Task[]

  @@index([type])
  @@index([layer])
}

model Task {
  id         String   @id @default(cuid())
  code       String
  eventId    String
  accountId  String
  status     String   @default("生成中")
  risk       String   @default("普通")
  candidates Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event   Event         @relation(fields: [eventId], references: [id])
  account Account       @relation(fields: [accountId], references: [id])
  post    PublishedPost?

  @@unique([eventId, accountId])
  @@index([status])
}

model PublishedPost {
  id                String   @id @default(cuid())
  taskId            String   @unique
  url               String   @unique
  publishedAt       DateTime
  selectedCandidate Int?
  trackingStatus    String   @default("追踪中")
  trackingEndsAt    DateTime
  wellPerforming    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  task    Task         @relation(fields: [taskId], references: [id])
  metrics PostMetric[]

  @@index([publishedAt])
  @@index([trackingStatus])
}

model PostMetric {
  id         String        @id @default(cuid())
  postId     String
  views      Int?
  likes      Int?
  replies    Int?
  reposts    Int?
  quotes     Int?
  capturedAt DateTime
  post       PublishedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, capturedAt])
}
